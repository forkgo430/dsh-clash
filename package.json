{
  "name": "dsh-clash",
  "version": "0.1.0",
  "description": "Let the AI operate the local Clash (mihomo) kernel: list nodes and policy groups, switch nodes, test latency, change rule/global/direct mode, inspect and temporarily toggle routing rules, read live connections and traffic. Speaks the mihomo REST API — it neither owns the kernel process nor touches the system proxy switch.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "clash",
    "mihomo",
    "clash-verge",
    "proxy",
    "network"
  ],
  "license": "MIT",
  "author": "赢容 (forkgo430)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forkgo430/dsh-clash.git"
  },
  "homepage": "https://github.com/forkgo430/dsh-clash#readme",
  "bugs": {
    "url": "https://github.com/forkgo430/dsh-clash/issues"
  }
}